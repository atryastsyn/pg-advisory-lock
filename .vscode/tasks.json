{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "poetry-install",
            "type": "shell",
            "command": "poetry install",
            "problemMatcher": []
        },
        {
            "label": "project-version",
            "type": "shell",
            "command": "poetry version -s",
            "problemMatcher": []
        },
        {
            "label": "git-create-tag",
            "type": "shell",
            "command": "git tag -a v${input:releaseVersion} -m \"Release v${input:releaseVersion}\"",
            "problemMatcher": []
        },
        {
            "label": "git-push-tag",
            "type": "shell",
            "command": "git push origin v${input:releaseVersion}",
            "problemMatcher": []
        },
        {
            "label": "ruff-format",
            "type": "shell",
            "command": "poetry run ruff check --fix && poetry run ruff format",
            "problemMatcher": []
        },
        {
            "label": "tests-run",
            "type": "shell",
            "command": "poetry run pytest",
            "problemMatcher": []
        },
        {
            "label": "docker-up",
            "type": "shell",
            "command": "docker compose up -d",
            "problemMatcher": []
        },
        {
            "label": "docker-down",
            "type": "shell",
            "command": "docker compose down -v",
            "problemMatcher": []
        },
        {
            "label": "mypy-check",
            "type": "shell",
            "command": "poetry run mypy",
            "problemMatcher": []
        },
        {
            "label": "go-to-master",
            "type": "shell",
            "command": "git switch master && git pull --ff-only origin master",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "releaseVersion",
            "type": "promptString",
            "description": "Release version (without v prefix)"
        }
    ]
}
